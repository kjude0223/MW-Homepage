<div class="collection-page">
  <div class="section-inner">
    <p class="section-label">The Collection</p>
    <h1 class="section-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="section-sub">{{ collection.description }}</p>
    {%- endif -%}

    <div class="product-grid">
      {%- for product in collection.products -%}
        <div class="product-card">
          <a href="{{ product.url }}">
            <div class="product-img-wrap">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  style="width:100%;height:100%;object-fit:cover;" />
              {%- else -%}
                <div class="product-img-placeholder tee-bg"></div>
              {%- endif -%}
              {%- unless product.available -%}
                <div class="product-badge">Sold Out</div>
              {%- endunless -%}
            </div>
            <div class="product-info">
              <p class="product-cat">{{ product.type }}</p>
              <h3 class="product-name">{{ product.title }}</h3>
              <div class="product-footer">
                <span class="product-price">{{ product.price | money }}</span>
                <span class="btn btn-red btn-sm">Shop Now</span>
              </div>
            </div>
          </a>
        </div>
      {%- else -%}
        <p style="color:var(--text-muted);">No products found.</p>
      {%- endfor -%}
    </div>
  </div>
</div>

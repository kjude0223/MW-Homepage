<div class="section-inner" style="padding-top:120px;padding-bottom:80px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;">
  <div class="product-media">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" style="width:100%;border-radius:10px;" />
    {%- else -%}
      <div class="product-img-placeholder tee-bg" style="aspect-ratio:1;border-radius:10px;"></div>
    {%- endif -%}
  </div>
  <div class="product-details">
    <p class="product-cat">{{ product.type }}</p>
    <h1 class="product-name" style="font-size:2.4rem;margin-bottom:16px;">{{ product.title }}</h1>
    <p class="product-price" style="font-size:2rem;margin-bottom:24px;">{{ product.price | money }}</p>
    <div style="color:#888;margin-bottom:32px;line-height:1.7;">{{ product.description }}</div>
    {%- form 'product', product -%}
      <select name="id" style="width:100%;padding:12px;background:#181818;border:1px solid rgba(255,255,255,0.1);color:#E8E8E8;border-radius:6px;margin-bottom:16px;font-family:inherit;">
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}" {% if variant.available == false %}disabled{% endif %}>
            {{ variant.title }} — {{ variant.price | money }}
          </option>
        {%- endfor -%}
      </select>
      <button type="submit" name="add" class="btn btn-red btn-lg" style="width:100%;">Add to Cart</button>
    {%- endform -%}
  </div>
</div>

<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {%- if template == 'index' -%}Motion Workz – The Journey Is the Build.
    {%- else -%}{{ page_title }} – {{ shop.name }}
    {%- endif -%}
  </title>
  <meta name="description" content="{{ page_description | default: 'Motion Workz — JDM & import lifestyle brand from Georgia. Real builds, real roads. Merch funds the mission.' | escape }}" />
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
  {{ 'motion-workz.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <header class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="{{ routes.root_url }}" class="nav-logo">
        <span class="logo-motion">MOTION</span><span class="logo-workz">WORKZ</span>
      </a>
      <nav class="nav-links" id="navLinks">
        <a href="{{ routes.root_url }}">Home</a>
        <a href="/collections/all">Shop</a>
        <a href="/pages/builds">Builds</a>
        <a href="/pages/about">About</a>
      </nav>
      <a href="/collections/all" class="btn btn-red nav-cta">Shop the Drop</a>
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="nav-logo">
          <span class="logo-motion">MOTION</span><span class="logo-workz">WORKZ</span>
        </a>
        <p class="footer-tagline">The Journey Is the Build.</p>
        <p class="footer-location">JDM &amp; Import Lifestyle &nbsp;&middot;&nbsp; Georgia</p>
      </div>
      <nav class="footer-links">
        <a href="{{ routes.root_url }}">Home</a>
        <a href="/collections/all">Shop</a>
        <a href="/pages/builds">Builds</a>
        <a href="/pages/about">About</a>
      </nav>
      <div class="footer-social">
        {%- if settings.social_youtube_url != blank -%}
        <a href="{{ settings.social_youtube_url }}" class="social-icon" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#0A0A0A"/></svg>
        </a>
        {%- endif -%}
        {%- if settings.social_instagram_url != blank -%}
        <a href="{{ settings.social_instagram_url }}" class="social-icon" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        {%- endif -%}
        {%- if settings.social_tiktok_url != blank -%}
        <a href="{{ settings.social_tiktok_url }}" class="social-icon" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
        </a>
        {%- endif -%}
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} Motion Workz. All rights reserved. &nbsp;&middot;&nbsp; #MotionWorkz &nbsp;&middot;&nbsp; #TheJourneyIsTheBuild</p>
    </div>
  </footer>

  <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
    <symbol id="gear-svg" viewBox="0 0 100 100">
      <path d="M43.3 5.5l-2.6 9.7a33.5 33.5 0 0 0-8.2 3.4l-9-5.3-8.3 8.3 5.3 9a33.5 33.5 0 0 0-3.4 8.2l-9.7 2.6v11.7l9.7 2.6a33.5 33.5 0 0 0 3.4 8.2l-5.3 9 8.3 8.3 9-5.3a33.5 33.5 0 0 0 8.2 3.4l2.6 9.7h11.7l2.6-9.7a33.5 33.5 0 0 0 8.2-3.4l9 5.3 8.3-8.3-5.3-9a33.5 33.5 0 0 0 3.4-8.2l9.7-2.6V43.3l-9.7-2.6a33.5 33.5 0 0 0-3.4-8.2l5.3-9-8.3-8.3-9 5.3a33.5 33.5 0 0 0-8.2-3.4l-2.6-9.7zm5.9 27.5a17 17 0 1 1 0 34 17 17 0 0 1 0-34z"/>
    </symbol>
  </svg>

  <script src="{{ 'motion-workz.js' | asset_url }}" defer></script>
</body>
</html>

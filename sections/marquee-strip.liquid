<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-track">
    {%- assign items = section.settings.text | split: '|' -%}
    {%- for _i in (1..2) -%}
      {%- for item in items -%}
        <span>{{ item | strip }}</span><span class="dot">&#9679;</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Strip",
  "settings": [
    { "type": "text", "id": "text", "label": "Items (separate with |)", "default": "JDM Lifestyle | Real Builds | Import Scene | Georgia Car Culture | Driven Not Trailered | The Journey Is the Build" }
  ],
  "presets": [{ "name": "Marquee Strip" }]
}
{% endschema %}

<section class="hero" id="home">
  <div class="hero-bg-gears" aria-hidden="true">
    <svg class="gear gear-1" viewBox="0 0 100 100"><use href="#gear-svg"/></svg>
    <svg class="gear gear-2" viewBox="0 0 100 100"><use href="#gear-svg"/></svg>
    <svg class="gear gear-3" viewBox="0 0 100 100"><use href="#gear-svg"/></svg>
  </div>
  <div class="hero-content">
    <p class="hero-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="hero-title">{{ section.settings.headline }}</h1>
    <p class="hero-mission-line chrome-text">{{ section.settings.mission_line }}</p>
    <p class="hero-sub">{{ section.settings.subheadline }}</p>
    <div class="hero-actions">
      <a href="{{ section.settings.cta_primary_url }}" class="btn btn-red btn-lg btn-skew"><span>{{ section.settings.cta_primary_text }}</span></a>
      <a href="{{ section.settings.cta_secondary_url }}" class="btn btn-outline btn-lg btn-skew"><span>{{ section.settings.cta_secondary_text }}</span></a>
    </div>
  </div>
  <div class="hero-scroll-cue" aria-hidden="true"><span></span></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text",     "id": "eyebrow",       "label": "Eyebrow",        "default": "Import Lane · Open to Every Lane" },
    { "type": "textarea","id": "headline",      "label": "Headline",       "default": "The Journey Is the Build." },
    { "type": "text",    "id": "mission_line",  "label": "Mission line",   "default": "One Culture, Every Lane" },
    { "type": "textarea","id": "subheadline",   "label": "Subheadline",    "default": "Car culture shouldn't be siloed. Motion Workz brings it all under one roof — import, Euro, exotics, trucks, muscle — united by people who'd rather drive their build than let it collect dust." },
    { "type": "text",    "id": "cta_primary_text",   "label": "Primary CTA",   "default": "Shop the Tee" },
    { "type": "url",     "id": "cta_primary_url",    "label": "Primary link" },
    { "type": "text",    "id": "cta_secondary_text",  "label": "Secondary CTA", "default": "See the Builds" },
    { "type": "url",     "id": "cta_secondary_url",   "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

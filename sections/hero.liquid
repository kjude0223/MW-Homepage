<section class="hero" id="home">
  <div class="hero-bg-gears" aria-hidden="true">
    <svg class="gear gear-1" viewBox="0 0 100 100"><use href="#gear-svg"/></svg>
    <svg class="gear gear-2" viewBox="0 0 100 100"><use href="#gear-svg"/></svg>
    <svg class="gear gear-3" viewBox="0 0 100 100"><use href="#gear-svg"/></svg>
  </div>
  <div class="hero-content">
    <p class="hero-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="hero-title">{{ section.settings.headline }}</h1>
    <p class="hero-sub">{{ section.settings.subheadline }}</p>
    <div class="hero-actions">
      <a href="{{ section.settings.cta_primary_url }}" class="btn btn-red btn-lg">{{ section.settings.cta_primary_text }}</a>
      <a href="{{ section.settings.cta_secondary_url }}" class="btn btn-outline btn-lg">{{ section.settings.cta_secondary_text }}</a>
    </div>
  </div>
  <div class="hero-scroll-cue" aria-hidden="true"><span></span></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "JDM · Import · Lifestyle" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "The Journey Is the Build." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "From a right-hand-drive Skyline GT-T in Georgia to a GT-R — this is the real road. Motion Workz documents the builds, the lifestyle, and every mile in between. Merch funds the mission." },
    { "type": "text", "id": "cta_primary_text", "label": "Primary button text", "default": "Shop the Drop" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary_text", "label": "Secondary button text", "default": "Watch Our Builds" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

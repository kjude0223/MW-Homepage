<section class="about" id="about">
  <div class="about-glow" aria-hidden="true"></div>
  <div class="section-inner about-inner">

    <div class="about-car" aria-hidden="true">
      <div class="car-silhouette">
        <svg viewBox="0 0 320 120" class="skyline-svg" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 85 L40 85 Q50 55 80 45 L110 35 Q130 25 160 25 Q195 25 215 35 L240 45 Q265 50 275 65 L300 70 L300 85 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M115 35 L125 48 L195 48 L205 35 Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <line x1="158" y1="35" x2="158" y2="48" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="75" cy="85" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="75" cy="85" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="240" cy="85" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="240" cy="85" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <line x1="10" y1="103" x2="310" y2="103" stroke="currentColor" stroke-width="1" opacity="0.3"/>
          <text x="160" y="75" text-anchor="middle" font-family="'Barlow Condensed',sans-serif" font-weight="800" font-size="9" fill="currentColor" letter-spacing="1" opacity="0.6">SKYLINE GT-T</text>
        </svg>
        <p class="car-label">'99 Nissan Skyline GT-T &nbsp;&middot;&nbsp; Georgia &nbsp;&middot;&nbsp; Daily Driven</p>
      </div>
    </div>

    <div class="about-text">
      <p class="section-label">My Lane</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body_1 }}</p>
      <p>{{ section.settings.body_2 }}</p>
      <p class="about-tagline">&ldquo;{{ section.settings.tagline }}&rdquo;</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/pages/about" class="btn btn-outline">Full Story</a>
        <a href="/collections/all" class="btn btn-red btn-skew"><span>Shop the Tee</span></a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "textarea", "id": "heading",  "label": "Heading",    "default": "The Build That Started It All." },
    { "type": "textarea", "id": "body_1",   "label": "Paragraph 1", "default": "It started with learning to drive manual. From there it became cars, period — not one brand, not one type. Every one of them taught me something about the craftsmanship and engineering that goes into building something that fast, that precise. Hero car: 1999 Nissan Skyline GT-T (RHD), daily driven. Dream car: 2001 GT-R." },
    { "type": "textarea", "id": "body_2",   "label": "Paragraph 2", "default": "Motion Workz exists because nobody documents the build while they're in it — and everybody wishes they had, later. This brand is the record. The builds, the setbacks, the late nights. Every lane. Documented this time." },
    { "type": "text",     "id": "tagline",  "label": "Pull quote",  "default": "No badge. No border. Just the culture, in every lane." }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}

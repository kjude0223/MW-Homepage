<section class="about" id="about">
  <div class="about-glow" aria-hidden="true"></div>
  <div class="section-inner about-inner">

    <div class="about-car" aria-hidden="true">
      <div class="car-silhouette">
        <svg viewBox="0 0 320 120" class="skyline-svg" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 85 L40 85 Q50 55 80 45 L110 35 Q130 25 160 25 Q195 25 215 35 L240 45 Q265 50 275 65 L300 70 L300 85 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M115 35 L125 48 L195 48 L205 35 Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <line x1="158" y1="35" x2="158" y2="48" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="75" cy="85" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="75" cy="85" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="240" cy="85" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="240" cy="85" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <line x1="10" y1="103" x2="310" y2="103" stroke="currentColor" stroke-width="1" opacity="0.3"/>
          <text x="160" y="75" text-anchor="middle" font-family="'Barlow Condensed',sans-serif" font-weight="800" font-size="9" fill="currentColor" letter-spacing="1" opacity="0.6">SKYLINE GT-T</text>
        </svg>
        <p class="car-label">'99 Nissan Skyline GT-T &nbsp;&middot;&nbsp; Georgia</p>
      </div>
    </div>

    <div class="about-text">
      <p class="section-label">Who We Are</p>
      <h2 class="section-title">Average Build.<br /><span class="red">Real Passion.</span></h2>
      <p>{{ section.settings.body_1 }}</p>
      <p>{{ section.settings.body_2 }}</p>
      <p>{{ section.settings.body_3 }}</p>
      <p class="about-tagline">&ldquo;That&rsquo;s Motion Workz.&rdquo;</p>
      <a href="/collections/all" class="btn btn-red">Shop &amp; Support the Mission</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "textarea", "id": "body_1", "label": "Paragraph 1", "default": "Motion Workz started with one goal — get to the GT-R. But the real story is everything in between. Based in Georgia, we document everyday JDM and import builds from people who actually drive their cars." },
    { "type": "textarea", "id": "body_2", "label": "Paragraph 2", "default": "No trailer queens. No perfect builds. Just real enthusiasts putting in the work and enjoying the ride." },
    { "type": "textarea", "id": "body_3", "label": "Paragraph 3", "default": "The merch keeps the content going. The content tells the stories that don't get told — the average build that took two years, the car that barely made it to the meet, the drive that reminded you why you got into this in the first place." }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}

<section class="featured-builds" id="builds">
  <div class="section-inner">
    <p class="section-label">Current Builds</p>
    <h2 class="section-title">The Build That<br /><span class="red">Started It All.</span></h2>
    <p class="section-sub">Real car. Real miles. Documented as it happens — every mod, every setback, every win. This is the Import Lane.</p>

    <div class="builds-feature-grid">

      <div class="build-feature-card">
        <div class="build-feature-img">
          <span class="build-lane-tag">Import Lane</span>
          <svg viewBox="0 0 320 120" class="skyline-svg" xmlns="http://www.w3.org/2000/svg" style="max-width:280px;margin:0 auto;">
            <path d="M20 85 L40 85 Q50 55 80 45 L110 35 Q130 25 160 25 Q195 25 215 35 L240 45 Q265 50 275 65 L300 70 L300 85 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <path d="M115 35 L125 48 L195 48 L205 35 Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <line x1="158" y1="35" x2="158" y2="48" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="75" cy="85" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
            <circle cx="75" cy="85" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="240" cy="85" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
            <circle cx="240" cy="85" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>
        <div class="build-feature-body">
          <span class="build-car-name">'99 Nissan Skyline GT-T</span>
          <span class="build-owner-tag">Gerardo &nbsp;&middot;&nbsp; Georgia &nbsp;&middot;&nbsp; Daily Driven</span>
          <p class="build-blurb">Right-hand drive. Nothing precious about it. This is the build that started the brand — documented in real time, one mod at a time, on the way to a GT-R.</p>
          <a href="/pages/builds" class="btn btn-outline btn-sm">Watch the Build Diary</a>
        </div>
      </div>

      <div class="submit-build-card">
        <div class="submit-build-plus">+</div>
        <h3 style="font-family:var(--font-head);font-size:1.8rem;font-weight:900;text-transform:uppercase;font-style:italic;color:var(--silver-light);margin-bottom:8px;">Your Build Here.</h3>
        <p style="font-size:0.9rem;color:var(--text-muted);line-height:1.6;max-width:280px;">Import, Euro, truck, muscle — every lane is open. If you built it and you drive it, submit your build.</p>
        <a href="/pages/submit-your-build" class="btn btn-red btn-skew"><span>Submit Your Build</span></a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Builds",
  "settings": [],
  "presets": [{ "name": "Featured Builds" }]
}
{% endschema %}

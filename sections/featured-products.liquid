<section class="products" id="shop">
  <div class="section-inner">
    <p class="section-label">The Collection</p>
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <p class="section-sub">{{ section.settings.subheading }}</p>

    <div class="product-grid">
      {%- if section.settings.collection != blank -%}
        {%- assign col = collections[section.settings.collection] -%}
        {%- for product in col.products limit: 9 -%}
          <div class="product-card">
            <a href="{{ product.url }}">
              <div class="product-img-wrap">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
                {%- else -%}
                  <div class="product-img-placeholder tee-bg">
                    <svg viewBox="0 0 120 100" class="product-icon"><path d="M10 20 L30 10 L45 25 Q60 35 75 25 L90 10 L110 20 L100 45 L85 40 L85 90 L35 90 L35 40 L20 45 Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
                  </div>
                {%- endif -%}
                {%- unless product.available -%}
                  <div class="product-badge">Sold Out</div>
                {%- endunless -%}
              </div>
              <div class="product-info">
                <p class="product-cat">{{ product.type }}</p>
                <h3 class="product-name">{{ product.title }}</h3>
                <p class="product-desc">{{ product.description | strip_html | truncate: 90 }}</p>
                <div class="product-footer">
                  <span class="product-price">{{ product.price | money }}</span>
                  <span class="btn btn-red btn-sm">Shop Now</span>
                </div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholder cards shown before a collection is connected -->
        <div class="product-card">
          <div class="product-img-wrap">
            <div class="product-img-placeholder tee-bg">
              <svg viewBox="0 0 120 100" class="product-icon"><path d="M10 20 L30 10 L45 25 Q60 35 75 25 L90 10 L110 20 L100 45 L85 40 L85 90 L35 90 L35 40 L20 45 Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
            </div>
            <div class="product-badge">New Drop</div>
          </div>
          <div class="product-info">
            <p class="product-cat">Tee Shirts</p>
            <h3 class="product-name">MW Logo Tee</h3>
            <p class="product-desc">Heavy-weight cotton, screen-printed gear logo. Built to last like a well-tuned engine.</p>
            <div class="product-footer"><span class="product-price">$32</span><a href="/collections/all" class="btn btn-red btn-sm">Shop Now</a></div>
          </div>
        </div>
        <div class="product-card featured">
          <div class="product-img-wrap">
            <div class="product-img-placeholder tee-alt-bg">
              <div class="product-text-icon">
                <span class="pti-line1">BUILT</span>
                <span class="pti-line2">NOT</span>
                <span class="pti-line3">BOUGHT</span>
              </div>
            </div>
            <div class="product-badge bestseller">Fan Favorite</div>
          </div>
          <div class="product-info">
            <p class="product-cat">Tee Shirts</p>
            <h3 class="product-name">Built Not Bought Tee</h3>
            <p class="product-desc">A statement every real enthusiast lives by. For the builders, not the buyers.</p>
            <div class="product-footer"><span class="product-price">$32</span><a href="/collections/all" class="btn btn-red btn-sm">Shop Now</a></div>
          </div>
        </div>
        <div class="product-card">
          <div class="product-img-wrap">
            <div class="product-img-placeholder hoodie-bg">
              <svg viewBox="0 0 120 110" class="product-icon"><path d="M40 15 Q50 5 60 8 Q70 5 80 15 L95 30 L110 35 L105 60 L88 55 L88 100 L32 100 L32 55 L15 60 L10 35 L25 30 Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
            </div>
            <div class="product-badge">New Drop</div>
          </div>
          <div class="product-info">
            <p class="product-cat">Hoodies</p>
            <h3 class="product-name">MW Hoodie</h3>
            <p class="product-desc">Premium fleece with embroidered MW logo. For cold track mornings and late garage nights.</p>
            <div class="product-footer"><span class="product-price">$58</span><a href="/collections/all" class="btn btn-red btn-sm">Shop Now</a></div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div style="text-align:center;margin-top:48px;">
      <a href="/collections/all" class="btn btn-outline btn-lg">View All Products</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gear Up." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every purchase fuels the next build, the next video, and the journey to the GT-R." },
    { "type": "collection", "id": "collection", "label": "Collection to show" }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
